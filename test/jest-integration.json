{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "modulePathIgnorePatterns": ["<rootDir>/.worktrees/"],
  "testEnvironment": "node",
  "testRegex": ".*\\.integration-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": { "^uuid$": "<rootDir>/test/mocks/uuid.ts" }
}
