# ============================================
# GADO API — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# App
NODE_ENV=development
PORT=8080
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gado?schema=gado_fazendas

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=1h

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# Throttle (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
