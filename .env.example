# ============================================
# GADO API — Environment Variables
# ============================================

# ─── App ─────────────────────────────────────
NODE_ENV=development
PORT=8080
API_PREFIX=

# URL pública da API (OAuth callbacks, links)
# Dev: http://localhost:8080 | Prod: https://api.gadoos.com.br
API_URL=http://localhost:8080

# URL pública do Frontend (redirect pós-OAuth)
# Dev: http://localhost:5173 | Prod: https://app.gadoos.com.br
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gado?schema=gado_fazendas

# ─── JWT ─────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=8h

# ─── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ───────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Multi-Tenancy ──────────────────────────
TENANT_DEV_MODE=true
TENANT_BASE_DOMAIN=gado.com.br

# ─── Google OAuth 2.0 ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Trial ───────────────────────────────────
TRIAL_DAYS=30
