// ============================================
// SCHEMA ADMIN: gado_admin
// Gestão SaaS, billing, tenant provisioning
// Baseado no padrão epi-management-api
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-admin"
}

datasource db {
  provider = "postgresql"
  schemas  = ["gado_admin"]
}

model Organizacao {
  id           String              @id @default(uuid()) @db.Uuid
  razaoSocial  String              @map("razao_social") @db.VarChar(200)
  nomeFantasia String              @map("nome_fantasia") @db.VarChar(200)
  cnpj         String?             @unique @db.VarChar(18)
  email        String              @db.VarChar(150)
  telefone     String?             @db.VarChar(20)
  subdomain    String              @unique @db.VarChar(63)
  schemaName   String              @map("schema_name") @unique @db.VarChar(63)
  status       OrganizacaoStatus   @default(TRIAL)
  createdAt    DateTime            @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @map("updated_at") @updatedAt @db.Timestamptz(6)

  assinaturas    Assinatura[]
  tenantRegistry TenantRegistry?
  acessos        AcessoOrganizacao[]
  convites       Convite[]

  @@map("organizacoes")
  @@schema("gado_admin")
}

model Plano {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @db.VarChar(100)
  maxUsuarios   Int      @map("max_usuarios")
  maxFazendas   Int      @map("max_fazendas") @default(1)
  precoMensal   Decimal  @map("preco_mensal") @db.Decimal(10, 2)
  ativo         Boolean  @default(true)
  createdAt     DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @map("updated_at") @updatedAt @db.Timestamptz(6)

  assinaturas Assinatura[]

  @@map("planos")
  @@schema("gado_admin")
}

model Assinatura {
  id              String           @id @default(uuid()) @db.Uuid
  organizacaoId   String           @map("organizacao_id") @db.Uuid
  planoId         String           @map("plano_id") @db.Uuid
  status          AssinaturaStatus @default(ATIVA)
  dataInicio      DateTime         @map("data_inicio") @db.Date
  dataVencimento  DateTime         @map("data_vencimento") @db.Date
  diaVencimento   Int              @map("dia_vencimento")
  gracePeriodDias Int              @map("grace_period_dias") @default(7)
  createdAt       DateTime         @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @map("updated_at") @updatedAt @db.Timestamptz(6)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  plano       Plano      @relation(fields: [planoId], references: [id])
  pagamentos  Pagamento[]

  @@map("assinaturas")
  @@schema("gado_admin")
}

model Pagamento {
  id            String          @id @default(uuid()) @db.Uuid
  assinaturaId  String          @map("assinatura_id") @db.Uuid
  valor         Decimal         @db.Decimal(10, 2)
  competencia   String          @db.VarChar(7) // "2026-09"
  status        PagamentoStatus @default(PENDENTE)
  dataPagamento DateTime?       @map("data_pagamento") @db.Date
  observacao    String?
  createdAt     DateTime        @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @map("updated_at") @updatedAt @db.Timestamptz(6)

  assinatura Assinatura @relation(fields: [assinaturaId], references: [id])

  @@map("pagamentos")
  @@schema("gado_admin")
}

model TenantRegistry {
  id            String               @id @default(uuid()) @db.Uuid
  organizacaoId String               @map("organizacao_id") @unique @db.Uuid
  subdomain     String               @unique @db.VarChar(63)
  schemaName    String               @map("schema_name") @unique @db.VarChar(63)
  status        TenantRegistryStatus @default(PROVISIONANDO)
  provisionedAt DateTime?            @map("provisioned_at") @db.Timestamptz(6)
  createdAt     DateTime             @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @map("updated_at") @updatedAt @db.Timestamptz(6)

  organizacao      Organizacao       @relation(fields: [organizacaoId], references: [id])
  provisioningRuns ProvisioningRun[]

  @@map("tenant_registry")
  @@schema("gado_admin")
}

model ProvisioningRun {
  id               String            @id @default(uuid()) @db.Uuid
  tenantRegistryId String            @map("tenant_registry_id") @db.Uuid
  idempotencyKey   String            @map("idempotency_key") @unique @db.VarChar(100)
  state            ProvisioningState @default(REGISTERED)
  attempt          Int               @default(1)
  createdAt        DateTime          @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @map("updated_at") @updatedAt @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)

  tenantRegistry TenantRegistry      @relation(fields: [tenantRegistryId], references: [id], onDelete: Cascade)
  steps          ProvisioningStep[]
  outboxEvents   OnboardingOutbox[]

  @@index([tenantRegistryId, state])
  @@map("provisioning_runs")
  @@schema("gado_admin")
}

model ProvisioningStep {
  id           String                 @id @default(uuid()) @db.Uuid
  runId        String                 @map("run_id") @db.Uuid
  state        ProvisioningState
  attempt      Int                    @default(1)
  status       ProvisioningStepStatus @default(PENDING)
  startedAt    DateTime?              @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?              @map("completed_at") @db.Timestamptz(6)
  errorCode    String?                @map("error_code") @db.VarChar(100)
  errorMessage String?                @map("error_message")
  createdAt    DateTime               @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @map("updated_at") @updatedAt @db.Timestamptz(6)

  run ProvisioningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, state, attempt])
  @@index([runId, status])
  @@map("provisioning_steps")
  @@schema("gado_admin")
}

model OnboardingOutbox {
  id                String                 @id @default(uuid()) @db.Uuid
  provisioningRunId String                 @map("provisioning_run_id") @db.Uuid
  eventKey          String                 @map("event_key") @unique @db.VarChar(160)
  recipient         String                 @db.VarChar(320)
  templateKey       String                 @map("template_key") @db.VarChar(100)
  payload           Json
  status            OnboardingOutboxStatus @default(PENDING)
  attempts          Int                    @default(0)
  nextAttemptAt     DateTime               @map("next_attempt_at") @default(now()) @db.Timestamptz(6)
  sentAt            DateTime?              @map("sent_at") @db.Timestamptz(6)
  errorCode         String?                @map("error_code") @db.VarChar(100)
  createdAt         DateTime               @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @map("updated_at") @updatedAt @db.Timestamptz(6)

  provisioningRun ProvisioningRun @relation(fields: [provisioningRunId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("onboarding_outbox")
  @@schema("gado_admin")
}

model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  nome      String    @db.VarChar(200)
  email     String    @unique @db.VarChar(150)
  senhaHash String    @map("senha_hash") @db.VarChar(255)
  role      AdminRole @default(SUPPORT)
  ativo     Boolean   @default(true)
  createdAt DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @map("updated_at") @updatedAt @db.Timestamptz(6)

  @@map("admin_users")
  @@schema("gado_admin")
}

model UsuarioGlobal {
  id            String       @id @default(uuid()) @db.Uuid
  nome          String       @db.VarChar(200)
  email         String       @unique @db.VarChar(150)
  senhaHash     String?      @map("senha_hash") @db.VarChar(255)
  googleId      String?      @map("google_id") @unique @db.VarChar(255)
  fotoUrl       String?      @map("foto_url") @db.VarChar(500)
  authProvider  AuthProvider @map("auth_provider") @default(EMAIL)
  ativo         Boolean      @default(true)
  createdAt     DateTime     @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @map("updated_at") @updatedAt @db.Timestamptz(6)

  acessos  AcessoOrganizacao[]
  convites Convite[]           @relation("ConviteConvidadoPor")

  @@map("usuarios_globais")
  @@schema("gado_admin")
}

model AcessoOrganizacao {
  id              String          @id @default(uuid()) @db.Uuid
  usuarioGlobalId String          @map("usuario_global_id") @db.Uuid
  organizacaoId   String          @map("organizacao_id") @db.Uuid
  role            RoleOrganizacao @default(CONVIDADO)
  status          StatusAcesso    @default(PENDENTE)
  createdAt       DateTime        @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @map("updated_at") @updatedAt @db.Timestamptz(6)

  usuario     UsuarioGlobal @relation(fields: [usuarioGlobalId], references: [id], onDelete: Cascade)
  organizacao Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioGlobalId, organizacaoId])
  @@map("acesso_organizacoes")
  @@schema("gado_admin")
}

model Convite {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @db.VarChar(150)
  organizacaoId   String        @map("organizacao_id") @db.Uuid
  convidadoPorId  String        @map("convidado_por_id") @db.Uuid
  tokenHash       String        @map("token_hash") @unique @db.VarChar(255)
  role            RoleOrganizacao @default(CONVIDADO)
  status          StatusConvite @default(PENDENTE)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime      @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @map("updated_at") @updatedAt @db.Timestamptz(6)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)

  organizacao  Organizacao   @relation(fields: [organizacaoId], references: [id])
  convidadoPor UsuarioGlobal @relation("ConviteConvidadoPor", fields: [convidadoPorId], references: [id])

  @@index([organizacaoId, email, status], map: "convites_organizacao_email_status_idx")
  @@map("convites")
  @@schema("gado_admin")
}

// --- Enums Admin ---

enum OrganizacaoStatus {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
  @@schema("gado_admin")
}

enum AssinaturaStatus {
  ATIVA
  VENCIDA
  CANCELADA
  @@schema("gado_admin")
}

enum PagamentoStatus {
  PENDENTE
  PAGO
  ATRASADO
  @@schema("gado_admin")
}

enum TenantRegistryStatus {
  PROVISIONANDO
  ATIVO
  BLOQUEADO
  REMOVIDO
  @@schema("gado_admin")
}

enum ProvisioningState {
  REGISTERED
  PROVISIONING_SCHEMA
  APPLYING_MIGRATIONS
  SEEDING
  VALIDATING
  ACTIVE
  @@schema("gado_admin")
}

enum ProvisioningStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  @@schema("gado_admin")
}

enum OnboardingOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  @@schema("gado_admin")
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  @@schema("gado_admin")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  @@schema("gado_admin")
}

enum RoleOrganizacao {
  PROPRIETARIO
  CONVIDADO
  @@schema("gado_admin")
}

enum StatusAcesso {
  PENDENTE
  ATIVO
  RECUSADO
  REVOGADO
  SOLICITADO
  @@schema("gado_admin")
}

enum StatusConvite {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
  @@schema("gado_admin")
}
